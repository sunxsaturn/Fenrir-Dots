#!/usr/bin/env bash
set -Eeuo pipefail

UI_URL="http://127.0.0.1:8765"
OLLAMA_UNIT="ollama.service"
STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}/fenrir-doctor"
STARTED_MARKER="$STATE_HOME/ollama-started-by-fenrir-doctor"

usage() {
  cat <<'USAGE'
Fenrir Doctor local runtime control

Usage: fenrir-doctor {open|start|stop|status|logs|upgrade}
  open     Start Ollama only when needed, start Doctor, and open the dashboard
  start    Start Ollama and the local Doctor dashboard service
  stop     Stop Doctor and an Ollama service started by Doctor
  status   Show local model and Doctor dashboard status
  logs     Show the Doctor user-service journal
  upgrade  Open the interactive Fenrir upgrade terminal
USAGE
}

wait_for_url() {
  local url="$1" tries="${2:-45}"
  for _ in $(seq 1 "$tries"); do
    curl --silent --fail "$url" >/dev/null 2>&1 && return 0
    sleep 1
  done
  return 1
}

start_runtime() {
  command -v pkexec >/dev/null 2>&1 || { echo "pkexec is missing; install polkit and start the Hyprland authentication agent." >&2; exit 1; }
  if ! systemctl is-active --quiet "$OLLAMA_UNIT"; then
    echo "Starting local Ollama service through the graphical authorization prompt..."
    pkexec /usr/bin/systemctl start "$OLLAMA_UNIT"
    mkdir -p "$STATE_HOME"
    : > "$STARTED_MARKER"
    chmod 0600 "$STARTED_MARKER"
  fi
  systemctl --user start fenrir-doctor.service
  if ! wait_for_url "$UI_URL/api/health" 30; then
    systemctl --user --no-pager --full status fenrir-doctor.service || true
    echo "Fenrir Doctor did not start. Inspect: fenrir-doctor logs" >&2
    exit 1
  fi
}

case "${1:-open}" in
  open)
    start_runtime
    if command -v xdg-open >/dev/null 2>&1; then
      xdg-open "$UI_URL" >/dev/null 2>&1 &
    else
      printf 'Open %s in a browser.\n' "$UI_URL"
    fi
    ;;
  start)
    start_runtime
    echo "Fenrir Doctor is ready at $UI_URL"
    ;;
  stop)
    systemctl --user stop fenrir-doctor.service 2>/dev/null || true
    if [[ -e "$STARTED_MARKER" ]]; then
      if systemctl is-active --quiet "$OLLAMA_UNIT"; then
        pkexec /usr/bin/systemctl stop "$OLLAMA_UNIT"
      fi
      rm -f -- "$STARTED_MARKER"
      echo "Fenrir Doctor and its Ollama runtime stopped. GPU and RAM are released."
    else
      echo "Fenrir Doctor stopped. Ollama was already running, so it was left untouched."
    fi
    ;;
  status)
    printf 'Fenrir Doctor UI: '
    systemctl --user is-active fenrir-doctor.service 2>/dev/null || true
    printf 'Ollama: '
    systemctl is-active "$OLLAMA_UNIT" 2>/dev/null || true
    [[ -e "$STARTED_MARKER" ]] && echo 'Ollama was started by Fenrir Doctor.' || true
    if command -v ollama >/dev/null 2>&1 && systemctl is-active --quiet "$OLLAMA_UNIT"; then
      ollama list || true
    fi
    printf 'Dashboard: %s\n' "$UI_URL"
    ;;
  logs)
    journalctl --user -u fenrir-doctor.service -n 100 --no-pager
    ;;
  upgrade)
    command -v kitty >/dev/null 2>&1 || { echo "Kitty terminal is required." >&2; exit 1; }
    command -v fenrir-upgrade >/dev/null 2>&1 || { echo "Fenrir upgrade helper is not installed." >&2; exit 1; }
    exec kitty --title "Fenrir Upgrade" fenrir-upgrade apply
    ;;
  -h|--help|help) usage ;;
  *) usage >&2; exit 2 ;;
esac
