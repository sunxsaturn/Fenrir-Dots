#!/usr/bin/env bash
set -Eeuo pipefail

REPOSITORY="https://github.com/sunxsaturn/Fenrir-Arch.git"
ARCH_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/fenrir/arch-source"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/fenrir"
STATE_FILE="$STATE_DIR/upgrade-state"
PREVIOUS_SHA=""
TARGET_SHA=""
TARGET_REF=""
UPGRADE_STATUS=""

usage() {
  cat <<'USAGE'
Fenrir Upgrade

Usage: fenrir-upgrade {check|preflight|status|apply|rollback}
  check      Fetch release tags and show the newest supported release
  preflight  Validate the checkout, release target and installer without applying
  status     Show the current source revision and the most recent upgrade result
  apply      Run the interactive installer with source-revision recovery on failure
  rollback   Restore the source checkout to the revision saved before the last apply

Rollback restores the Fenrir-Arch source checkout only. It cannot reverse
package transactions or every system-level change already performed by an installer.
USAGE
}

fail() {
  echo "fenrir-upgrade: $*" >&2
  exit 1
}

require_git() {
  command -v git >/dev/null 2>&1 || fail "Git is required."
  command -v realpath >/dev/null 2>&1 || fail "realpath is required."
}

guard_paths() {
  local resolved_arch resolved_state
  [[ ! -L "$ARCH_DIR" ]] || fail "Refusing a symbolic-link source checkout: $ARCH_DIR"
  resolved_arch="$(realpath -m -- "$ARCH_DIR")"
  resolved_state="$(realpath -m -- "$STATE_DIR")"
  case "$resolved_arch" in
    /mnt/storage|/mnt/storage/*) fail "The protected /mnt/storage tree is never used by Fenrir Upgrade." ;;
  esac
  case "$resolved_state" in
    /mnt/storage|/mnt/storage/*) fail "Upgrade state may not be written under protected /mnt/storage." ;;
  esac
  [[ ! -L "$STATE_DIR" ]] || fail "Refusing a symbolic-link upgrade state directory: $STATE_DIR"
  [[ ! -L "$STATE_FILE" ]] || fail "Refusing a symbolic-link upgrade state file: $STATE_FILE"
}

prepare_checkout() {
  guard_paths
  mkdir -p -- "$(dirname -- "$ARCH_DIR")"
  if [[ -d "$ARCH_DIR/.git" ]]; then
    local remote
    remote="$(git -C "$ARCH_DIR" remote get-url origin)"
    case "$remote" in
      "$REPOSITORY"|"https://github.com/sunxsaturn/Fenrir-Arch"|git@github.com:sunxsaturn/Fenrir-Arch.git) ;;
      *) fail "Refusing unexpected Git remote in $ARCH_DIR: $remote" ;;
    esac
  elif [[ -e "$ARCH_DIR" ]]; then
    fail "$ARCH_DIR exists but is not a Git checkout; move it aside before upgrading."
  else
    git clone "$REPOSITORY" "$ARCH_DIR"
  fi
  git -C "$ARCH_DIR" fetch --prune --tags origin
}

latest_release() {
  git -C "$ARCH_DIR" tag --list 'v[0-9]*' --sort=-version:refname | sed -n '1p'
}

require_clean_worktree() {
  local dirty
  dirty="$(git -C "$ARCH_DIR" status --porcelain)"
  [[ -z "$dirty" ]] || fail "The Fenrir-Arch source checkout has local changes. Commit or move them before upgrading; no files were overwritten."
}

resolve_target() {
  local tag="$1"
  if [[ -n "$tag" ]]; then
    TARGET_REF="$tag"
    TARGET_SHA="$(git -C "$ARCH_DIR" rev-parse "$tag^{commit}")"
  else
    TARGET_REF="main"
    TARGET_SHA="$(git -C "$ARCH_DIR" rev-parse "origin/main^{commit}")"
  fi
  [[ "$TARGET_SHA" =~ ^[0-9a-fA-F]{40,64}$ ]] || fail "Git did not return a valid target commit."
}

write_state() {
  local status="$1" temporary
  [[ "$PREVIOUS_SHA" =~ ^[0-9a-fA-F]{40,64}$ ]] || fail "Refusing to store an invalid previous revision."
  [[ "$TARGET_SHA" =~ ^[0-9a-fA-F]{40,64}$ ]] || fail "Refusing to store an invalid target revision."
  [[ "$TARGET_REF" == "main" || "$TARGET_REF" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || fail "Refusing to store an invalid target reference."
  case "$status" in in_progress|completed|failed|rollback_failed|rolled_back) ;; *) fail "Invalid upgrade state." ;; esac
  mkdir -p -- "$STATE_DIR"
  [[ ! -L "$STATE_DIR" && ! -L "$STATE_FILE" ]] || fail "Refusing a symbolic-link state path."
  chmod 700 "$STATE_DIR"
  temporary="$(mktemp "$STATE_DIR/.upgrade-state.XXXXXX")"
  printf 'previous_sha=%s\ntarget_sha=%s\ntarget_ref=%s\nstatus=%s\n' \
    "$PREVIOUS_SHA" "$TARGET_SHA" "$TARGET_REF" "$status" > "$temporary"
  chmod 600 "$temporary"
  mv -f -- "$temporary" "$STATE_FILE"
}

read_state() {
  local -a lines=()
  [[ -f "$STATE_FILE" && ! -L "$STATE_FILE" ]] || fail "No safe upgrade state is available to inspect or roll back."
  [[ "$(stat -c '%s' "$STATE_FILE")" -le 2048 ]] || fail "Upgrade state file exceeds the safety limit."
  mapfile -t lines < "$STATE_FILE"
  [[ "${#lines[@]}" -eq 4 ]] || fail "Upgrade state file has an invalid format."
  [[ "${lines[0]}" == previous_sha=* ]] || fail "Upgrade state file is invalid."
  [[ "${lines[1]}" == target_sha=* ]] || fail "Upgrade state file is invalid."
  [[ "${lines[2]}" == target_ref=* ]] || fail "Upgrade state file is invalid."
  [[ "${lines[3]}" == status=* ]] || fail "Upgrade state file is invalid."
  PREVIOUS_SHA="${lines[0]#previous_sha=}"
  TARGET_SHA="${lines[1]#target_sha=}"
  TARGET_REF="${lines[2]#target_ref=}"
  UPGRADE_STATUS="${lines[3]#status=}"
  [[ "$PREVIOUS_SHA" =~ ^[0-9a-fA-F]{40,64}$ ]] || fail "Saved previous revision is invalid."
  [[ "$TARGET_SHA" =~ ^[0-9a-fA-F]{40,64}$ ]] || fail "Saved target revision is invalid."
  [[ "$TARGET_REF" == "main" || "$TARGET_REF" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || fail "Saved target reference is invalid."
  case "$UPGRADE_STATUS" in in_progress|completed|failed|rollback_failed|rolled_back) ;; *) fail "Saved upgrade status is invalid." ;; esac
}

preflight_checkout() {
  require_clean_worktree
  local tag
  tag="$(latest_release)"
  resolve_target "$tag"
  [[ -f "$ARCH_DIR/install.sh" && ! -L "$ARCH_DIR/install.sh" ]] || fail "The target checkout has no regular install.sh."
  bash -n "$ARCH_DIR/install.sh" || fail "The target installer failed its Bash syntax check."
  printf 'Preflight passed.\nTarget: %s (%s)\n' "$TARGET_REF" "$TARGET_SHA"
  printf 'Installer syntax: valid\nWorking tree: clean\n'
}

restore_previous_source() {
  if ! git -C "$ARCH_DIR" checkout --detach "$PREVIOUS_SHA"; then
    write_state "rollback_failed"
    echo "Automatic source rollback failed. Run 'fenrir-upgrade rollback' after inspecting the checkout." >&2
    return 1
  fi
  write_state "failed"
  echo "The installer failed. The Fenrir-Arch source checkout was returned to $PREVIOUS_SHA."
  echo "Package transactions and system-level changes already made by the installer may require separate recovery."
}

case "${1:-check}" in
  check)
    require_git
    prepare_checkout
    tag="$(latest_release)"
    if [[ -n "$tag" ]]; then
      printf 'Latest Fenrir-Arch release: %s\n' "$tag"
    else
      echo "No tagged release exists; origin/main is the available development target."
    fi
    current="$(git -C "$ARCH_DIR" rev-parse HEAD)"
    printf 'Current source revision: %s\n' "$current"
    if [[ -n "$(git -C "$ARCH_DIR" status --porcelain)" ]]; then
      echo "Working tree: modified (preflight/apply will refuse until it is clean)"
    else
      echo "Working tree: clean"
    fi
    ;;
  preflight)
    require_git
    prepare_checkout
    preflight_checkout
    ;;
  status)
    require_git
    guard_paths
    if [[ ! -d "$ARCH_DIR/.git" ]]; then
      echo "Fenrir-Arch source checkout is not initialized."
      exit 0
    fi
    printf 'Current source revision: %s\n' "$(git -C "$ARCH_DIR" rev-parse HEAD)"
    if [[ -n "$(git -C "$ARCH_DIR" status --porcelain)" ]]; then
      echo "Working tree: modified"
    else
      echo "Working tree: clean"
    fi
    if [[ -f "$STATE_FILE" && ! -L "$STATE_FILE" ]]; then
      read_state
      printf 'Last target: %s (%s)\nLast operation: %s\nPrevious revision: %s\n' \
        "$TARGET_REF" "$TARGET_SHA" "$UPGRADE_STATUS" "$PREVIOUS_SHA"
    else
      echo "No prior Fenrir Upgrade state is recorded."
    fi
    ;;
  apply)
    require_git
    prepare_checkout
    preflight_checkout
    PREVIOUS_SHA="$(git -C "$ARCH_DIR" rev-parse HEAD)"
    [[ "$PREVIOUS_SHA" =~ ^[0-9a-fA-F]{40,64}$ ]] || fail "Current source revision is invalid."
    write_state "in_progress"
    echo "Preparing Fenrir-Arch target $TARGET_REF ($TARGET_SHA)"
    git -C "$ARCH_DIR" checkout --detach "$TARGET_SHA"
    set +e
    bash "$ARCH_DIR/install.sh" --cli
    installer_status=$?
    set -e
    if [[ "$installer_status" -eq 0 ]]; then
      write_state "completed"
      echo "Fenrir installation completed. Source rollback is available through 'fenrir-upgrade rollback'."
      exit 0
    fi
    echo "Fenrir installer exited with status $installer_status." >&2
    restore_previous_source || true
    exit "$installer_status"
    ;;
  rollback)
    require_git
    prepare_checkout
    read_state
    [[ "$UPGRADE_STATUS" != "rolled_back" ]] || fail "The recorded source update is already rolled back."
    require_clean_worktree
    git -C "$ARCH_DIR" checkout --detach "$PREVIOUS_SHA"
    write_state "rolled_back"
    printf 'Restored Fenrir-Arch source revision %s.\n' "$PREVIOUS_SHA"
    echo "This restores the source checkout only, not package transactions or all system configuration changes."
    ;;
  -h|--help|help) usage ;;
  *) usage >&2; exit 2 ;;
esac
