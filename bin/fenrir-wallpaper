#!/usr/bin/env python3
"""Validated random wallpaper rotation for Hyprland + hyprpaper."""
from __future__ import annotations
import argparse
import colorsys
import json
import math
import os
import random
import re
import shutil
import subprocess
import sys
import time
import warnings
from pathlib import Path

EXTENSIONS = {".jpg", ".jpeg", ".png", ".webp"}
INDEX_VERSION = 2
PALETTE_POLICY_ID = "fenrir-wallpaper-palette-v1"
EXCLUDED_FAMILIES = {"yellow", "orange", "brown"}
PREFERRED_FAMILIES = {"red", "purple", "blue", "white", "black"}
ALLOWED_ACCENTS = {"green", "neutral"}
MAX_IMAGE_BYTES = 100 * 1024 * 1024
DEFAULT_MIN_WIDTH = 2560
DEFAULT_MIN_HEIGHT = 1440
DEFAULT_MIN_COUNT = 5000


def config_dir() -> Path:
    return Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))


def state_dir() -> Path:
    return Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "fenrir"


def settings() -> dict:
    cfg = config_dir() / "fenrir" / "settings.toml"
    if cfg.exists():
        try:
            import tomllib
            data = tomllib.loads(cfg.read_text(encoding="utf-8"))
            return data if isinstance(data, dict) else {}
        except Exception as exc:
            print(f"fenrir-wallpaper: ignoring invalid settings.toml: {exc}", file=sys.stderr)
    return {}


def wallpaper_dir() -> Path:
    raw = settings().get("wallpaper", {}).get("directory", "~/Pictures/Wallpapers")
    return Path(raw).expanduser()


def resolution_policy() -> tuple[int, int, int]:
    block = settings().get("wallpaper", {})
    width = max(DEFAULT_MIN_WIDTH, int(block.get("minimum_width", DEFAULT_MIN_WIDTH)))
    height = max(DEFAULT_MIN_HEIGHT, int(block.get("minimum_height", DEFAULT_MIN_HEIGHT)))
    count = max(DEFAULT_MIN_COUNT, int(block.get("minimum_count", DEFAULT_MIN_COUNT)))
    return width, height, count


def classify_hex_color(value: str) -> str:
    if not isinstance(value, str) or not re.fullmatch(r"#[0-9a-fA-F]{6}", value):
        raise ValueError("Color must use #RRGGBB.")
    red, green, blue = (int(value[index:index + 2], 16) / 255 for index in (1, 3, 5))
    hue, saturation, brightness = colorsys.rgb_to_hsv(red, green, blue)
    degrees = hue * 360.0
    if brightness >= 0.88 and saturation <= 0.20:
        return "white"
    if saturation <= 0.18:
        return "black" if brightness <= 0.14 else "neutral"
    if degrees < 15 or degrees >= 345:
        return "red"
    if 15 <= degrees < 43:
        return "brown" if brightness <= 0.78 else "orange"
    if 43 <= degrees < 70:
        return "yellow"
    if 70 <= degrees < 165:
        return "green"
    if 165 <= degrees < 260:
        return "blue"
    if 260 <= degrees < 330:
        return "purple"
    return "red"


def evaluate_palette(colors: list[str]) -> dict:
    if not isinstance(colors, list) or not 1 <= len(colors) <= 5:
        raise ValueError("Invalid wallpaper palette.")
    families = [classify_hex_color(color) for color in colors]
    excluded = sorted(set(families).intersection(EXCLUDED_FAMILIES))
    score = sum(2 if family in PREFERRED_FAMILIES else 1 if family == "green" else 0 for family in families)
    return {
        "eligible": not excluded,
        "families": families,
        "excluded_families": excluded,
        "preference_score": score,
    }


def inspect_image(path: Path) -> dict | None:
    try:
        stat = path.stat()
        if not path.is_file() or path.is_symlink() or stat.st_size > MAX_IMAGE_BYTES:
            return None
        from PIL import Image, ImageOps
        with warnings.catch_warnings():
            warnings.simplefilter("error", Image.DecompressionBombWarning)
            with Image.open(path) as image:
                image.load()
                oriented = ImageOps.exif_transpose(image)
                width, height = oriented.size
                if "A" in oriented.getbands() or "transparency" in oriented.info:
                    rgba = oriented.convert("RGBA")
                    background = Image.new("RGBA", rgba.size, (255, 255, 255, 255))
                    oriented = Image.alpha_composite(background, rgba)
                sample = oriented.convert("RGB")
                sample.thumbnail((128, 128), Image.Resampling.BOX)
                counts = sample.getcolors(maxcolors=128 * 128)
                if counts is None:
                    return None
                ranked = sorted(counts, key=lambda item: (-item[0], item[1]))[:5]
                colors = [
                    "#" + "".join(f"{channel:02x}" for channel in rgb)
                    for _, rgb in ranked
                ]
        palette = evaluate_palette(colors)
        return {
            "width": width,
            "height": height,
            "dominant_colors": colors,
            "palette_families": palette["families"],
            "palette_eligible": palette["eligible"],
            "excluded_families": palette["excluded_families"],
            "preference_score": palette["preference_score"],
        }
    except Exception:
        return None


def _write_index(records: dict[str, dict]) -> None:
    root = state_dir()
    root.mkdir(parents=True, exist_ok=True)
    destination = root / "wallpaper-index.json"
    temporary = destination.with_name(destination.name + f".tmp-{os.getpid()}")
    temporary.write_text(json.dumps({
        "version": INDEX_VERSION,
        "palette_policy": PALETTE_POLICY_ID,
        "items": records,
    }, separators=(",", ":")) + "\n", encoding="utf-8")
    os.chmod(temporary, 0o600)
    temporary.replace(destination)


def validated_wallpapers() -> tuple[list[Path], int, int, int, dict[str, int]]:
    root = wallpaper_dir()
    if not root.is_dir():
        raise RuntimeError(f"Wallpaper directory does not exist: {root}")
    min_width, min_height, _ = resolution_policy()
    index_path = state_dir() / "wallpaper-index.json"
    try:
        cached = json.loads(index_path.read_text(encoding="utf-8"))
        if (
            cached.get("version") != INDEX_VERSION
            or cached.get("palette_policy") != PALETTE_POLICY_ID
            or not isinstance(cached.get("items"), dict)
        ):
            cached = {"items": {}}
    except (OSError, ValueError, TypeError):
        cached = {"items": {}}
    old = cached.get("items", {})
    records: dict[str, dict] = {}
    valid: list[Path] = []
    scores: dict[str, int] = {}
    invalid = 0
    palette_excluded = 0
    files = sorted(
        p for p in root.rglob("*")
        if p.is_file() and p.suffix.lower() in EXTENSIONS and not p.is_symlink()
    )
    for path in files:
        try:
            metadata = path.stat()
            if path.is_symlink() or metadata.st_size > MAX_IMAGE_BYTES:
                invalid += 1
                continue
        except OSError:
            invalid += 1
            continue
        key = str(path.resolve())
        signature = {
            "device": metadata.st_dev,
            "inode": metadata.st_ino,
            "size": metadata.st_size,
            "mtime_ns": metadata.st_mtime_ns,
            "ctime_ns": metadata.st_ctime_ns,
        }
        entry = old.get(key)
        if (
            isinstance(entry, dict)
            and entry.get("signature") == signature
            and entry.get("palette_policy") == PALETTE_POLICY_ID
        ):
            details = entry.get("details")
        else:
            details = inspect_image(path)
        if not isinstance(details, dict):
            invalid += 1
            records[key] = {
                "signature": signature,
                "palette_policy": PALETTE_POLICY_ID,
                "details": None,
                "reason": "invalid_image",
            }
            continue

        width = int(details.get("width", 0))
        height = int(details.get("height", 0))
        dimensions_ok = width >= min_width and height >= min_height and width > height
        palette_ok = details.get("palette_eligible") is True
        is_valid = dimensions_ok and palette_ok
        reason = "valid" if is_valid else (
            "excluded_palette_color" if dimensions_ok and not palette_ok
            else "resolution_or_orientation"
        )
        records[key] = {
            "signature": signature,
            "palette_policy": PALETTE_POLICY_ID,
            "details": details,
            "reason": reason,
            "valid": is_valid,
        }
        if is_valid:
            valid.append(path)
            scores[key] = max(0, int(details.get("preference_score", 0)))
        else:
            invalid += 1
            if reason == "excluded_palette_color":
                palette_excluded += 1
    _write_index(records)
    return valid, invalid, len(files), palette_excluded, scores


def get_monitor_details() -> list[dict]:
    """Return connected monitor geometry without changing compositor state."""
    result = subprocess.run(
        ["hyprctl", "-j", "monitors"],
        capture_output=True,
        text=True,
        check=True,
        timeout=5,
    )
    payload = getattr(result, "stdout", None)
    if not isinstance(payload, (str, bytes, bytearray)):
        # Compatibility for callers that only provide the legacy monitor-name
        # helper (also useful for older integrations and isolated unit tests).
        return [{"name": name} for name in get_monitors()]
    data = json.loads(payload)
    if not isinstance(data, list):
        raise RuntimeError("Hyprland returned an invalid monitor list")
    return [
        item for item in data
        if isinstance(item, dict)
        and re.fullmatch(r"[A-Za-z0-9_.:-]{1,64}", str(item.get("name", "")))
    ]


def get_monitors() -> list[str]:
    """Return monitor names through the original stable helper contract."""
    result = subprocess.run(
        ["hyprctl", "-j", "monitors"],
        capture_output=True,
        text=True,
        check=True,
        timeout=5,
    )
    data = json.loads(result.stdout)
    if not isinstance(data, list):
        raise RuntimeError("Hyprland returned an invalid monitor list")
    return [
        str(item["name"]) for item in data
        if isinstance(item, dict) and item.get("name")
        and re.fullmatch(r"[A-Za-z0-9_.:-]{1,64}", str(item["name"]))
    ]


def _read_json_object(path: Path) -> dict:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError, TypeError):
        return {}
    return value if isinstance(value, dict) else {}


def _write_private_json(path: Path, value: dict) -> None:
    root = state_dir()
    root.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(path.name + f".tmp-{os.getpid()}")
    temporary.write_text(json.dumps(value, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    os.chmod(temporary, 0o600)
    temporary.replace(path)


def wallpaper_dimensions(path: Path, index: dict | None = None) -> tuple[int, int] | None:
    """Read dimensions from the current validated-image index."""
    if index is None:
        index = _read_json_object(state_dir() / "wallpaper-index.json")
    entry = index.get("items", {}).get(str(path.resolve()), {})
    details = entry.get("details") if isinstance(entry, dict) else None
    if not isinstance(details, dict):
        return None
    try:
        width, height = int(details.get("width", 0)), int(details.get("height", 0))
    except (TypeError, ValueError):
        return None
    return (width, height) if width > 0 and height > 0 else None


def choose_monitor_wallpaper(
    files: list[Path],
    monitor: dict,
    scores: dict[str, int],
    dimensions: dict[str, tuple[int, int] | None],
    recent_paths: list[str],
    current_path: str | None,
    history_depth: int,
) -> Path:
    """Choose an aspect-aware wallpaper outside that monitor's no-repeat window."""
    if not files:
        raise RuntimeError("No qualifying wallpapers are available for this monitor")
    recent = set(recent_paths[-history_depth:]) if history_depth > 0 else set()
    fresh = [
        path for path in files
        if str(path.resolve()) not in recent and str(path.resolve()) != current_path
    ]
    if not fresh:
        fresh = [path for path in files if str(path.resolve()) != current_path] or list(files)

    width, height = monitor.get("width"), monitor.get("height")
    try:
        target_ratio = float(width) / float(height) if float(width) > 0 and float(height) > 0 else None
    except (TypeError, ValueError, ZeroDivisionError):
        target_ratio = None

    weights = []
    for path in fresh:
        key = str(path.resolve())
        preference = max(1, int(scores.get(key, 0)))
        size = dimensions.get(key)
        ratio_fit = 1.0
        if target_ratio and size and size[0] > 0 and size[1] > 0:
            source_ratio = size[0] / size[1]
            # Smoothly prefer closer aspect ratios without excluding good images.
            ratio_fit = 1.0 / (1.0 + 4.0 * abs(math.log(source_ratio / target_ratio)))
        weights.append(max(0.05, preference * ratio_fit))
    return random.choices(fresh, weights=weights, k=1)[0]


def next_wallpapers() -> dict[str, Path]:
    """Build a per-output rotation plan, retaining the legacy shared mode."""
    try:
        monitors = get_monitor_details()
    except (OSError, subprocess.SubprocessError, json.JSONDecodeError) as exc:
        raise RuntimeError(f"Could not inspect connected monitors: {exc}") from exc
    if not monitors:
        raise RuntimeError("No connected Hyprland monitors were found")

    wallpaper_settings = settings().get("wallpaper", {})
    if wallpaper_settings.get("monitor_mode", "shared") != "independent":
        selected = next_wallpaper()
        return {str(item["name"]): selected for item in monitors}

    files, invalid, total, _palette_excluded, scores = validated_wallpapers()
    if not files:
        min_width, min_height, _minimum_count = resolution_policy()
        raise RuntimeError(
            f"No qualifying wallpapers found (checked {total} files; {invalid} rejected). "
            f"Add readable landscape images at least {min_width}x{min_height}."
        )
    state = _read_json_object(state_dir() / "wallpaper.json")
    history = _read_json_object(state_dir() / "wallpaper-history.json")
    histories = history.get("monitors", {}) if isinstance(history.get("monitors"), dict) else {}
    current = state.get("monitor_paths", {}) if isinstance(state.get("monitor_paths"), dict) else {}
    depth = wallpaper_settings.get("history_depth", 20)
    if isinstance(depth, bool) or not isinstance(depth, int):
        depth = 20
    depth = max(0, min(100, depth))
    image_index = _read_json_object(state_dir() / "wallpaper-index.json")
    dimensions = {
        str(path.resolve()): wallpaper_dimensions(path, image_index)
        for path in files
    }
    # Prefer the focused display first, then avoid duplicating choices on other outputs.
    ordered = sorted(monitors, key=lambda item: not bool(item.get("focused", False)))
    selected: dict[str, Path] = {}
    reserved: list[str] = []
    for monitor in ordered:
        name = str(monitor["name"])
        recent = list(histories.get(name, [])) if isinstance(histories.get(name, []), list) else []
        recent.extend(reserved)
        choice = choose_monitor_wallpaper(
            files,
            monitor,
            scores,
            dimensions,
            recent,
            current.get(name),
            depth,
        )
        selected[name] = choice
        reserved.append(str(choice.resolve()))
    return selected




def apply(path: Path | dict[str, Path]) -> None:
    """Apply one shared path or an explicit independently selected path per output."""
    details = []
    last_error = None
    for _ in range(12):
        try:
            details = get_monitor_details()
            if details:
                break
        except (OSError, subprocess.SubprocessError, json.JSONDecodeError) as exc:
            last_error = exc
        time.sleep(1)
    if not details:
        raise RuntimeError(f"Hyprland monitors unavailable; run this inside a Hyprland session ({last_error})")

    if isinstance(path, dict):
        requested = {str(name): Path(value) for name, value in path.items()}
        connected = {str(item["name"]) for item in details}
        unknown = set(requested) - connected
        if unknown:
            raise RuntimeError("Wallpaper plan references disconnected monitor(s): " + ", ".join(sorted(unknown)))
        if not requested:
            raise RuntimeError("Wallpaper plan contains no monitor selections")
        monitor_paths = requested
    else:
        monitor_paths = {str(item["name"]): Path(path) for item in details}

    resolved_paths: dict[str, Path] = {}
    for monitor_name, selected in monitor_paths.items():
        if not selected.is_file() or selected.is_symlink() or selected.suffix.lower() not in EXTENSIONS:
            raise RuntimeError(f"Selected wallpaper for {monitor_name} is not a supported regular image file")
        resolved_paths[monitor_name] = selected.resolve(strict=True)

    last_error = None
    for _ in range(12):
        try:
            for monitor_name, selected in resolved_paths.items():
                subprocess.run(
                    ["hyprctl", "hyprpaper", "wallpaper", f"{monitor_name},{selected},cover"],
                    check=True,
                    timeout=20,
                )
            last_error = None
            break
        except (OSError, subprocess.SubprocessError) as exc:
            last_error = exc
            time.sleep(1)
    if last_error is not None:
        raise RuntimeError(f"hyprpaper IPC did not become available: {last_error}")

    ordered = sorted(details, key=lambda item: not bool(item.get("focused", False)))
    primary_name = str(ordered[0]["name"])
    primary_path = resolved_paths.get(primary_name) or next(iter(resolved_paths.values()))
    state_payload = {
        "path": str(primary_path),
        "monitor_paths": {name: str(value) for name, value in resolved_paths.items()},
        "mode": "independent" if len(set(map(str, resolved_paths.values()))) > 1 else "shared",
        "changed_at": int(time.time()),
    }
    _write_private_json(state_dir() / "wallpaper.json", state_payload)

    history_path = state_dir() / "wallpaper-history.json"
    history = _read_json_object(history_path)
    histories = history.get("monitors", {}) if isinstance(history.get("monitors"), dict) else {}
    depth = settings().get("wallpaper", {}).get("history_depth", 20)
    if isinstance(depth, bool) or not isinstance(depth, int):
        depth = 20
    depth = max(0, min(100, depth))
    updated: dict[str, list[str]] = {}
    for name, selected in resolved_paths.items():
        prior = histories.get(name, [])
        prior = [item for item in prior if isinstance(item, str)] if isinstance(prior, list) else []
        value = str(selected)
        if not prior or prior[-1] != value:
            prior.append(value)
        updated[name] = prior[-depth:] if depth else []
    _write_private_json(history_path, {"version": 1, "monitors": updated})

    theme = shutil.which("fenrir-theme")
    dynamic_colors = settings().get("theme", {}).get("dynamic_colors", True)
    if theme and dynamic_colors:
        subprocess.run([theme, "--wallpaper", str(primary_path)], check=False, timeout=30, stdout=subprocess.DEVNULL)
    for name, selected in resolved_paths.items():
        print(f"{name}: {selected}")


def next_wallpaper() -> Path:
    files, invalid, total, palette_excluded, scores = validated_wallpapers()
    min_width, min_height, minimum_count = resolution_policy()
    if not files:
        raise RuntimeError(
            f"No qualifying wallpapers found (checked {total} files; {invalid} rejected). "
            f"Add readable landscape images at least {min_width}x{min_height}. "
            f"The long-term collection target is {minimum_count}, but rotation does not wait for it."
        )
    state = state_dir() / "wallpaper.json"
    current = None
    try:
        current = json.loads(state.read_text(encoding="utf-8")).get("path")
    except (OSError, ValueError, TypeError):
        pass
    candidates = [path for path in files if str(path.resolve()) != current]
    choices = candidates or files
    weights = [max(1, scores.get(str(path.resolve()), 0)) for path in choices]
    return random.choices(choices, weights=weights, k=1)[0]


def report_status(as_json: bool = False) -> int:
    valid, invalid, total, palette_excluded, _scores = validated_wallpapers()
    _, _, minimum_count = resolution_policy()
    result = {
        "directory": str(wallpaper_dir()), "valid_count": len(valid),
        "rejected_count": invalid, "excluded_palette_count": palette_excluded, "file_count": total,
        "minimum_count": minimum_count, "minimum_resolution": "2560x1440",
        "preferred_resolution": "3840x2160+", "palette_policy": PALETTE_POLICY_ID,
        "excluded_colors": sorted(EXCLUDED_FAMILIES),
        "preferred_colors": sorted(PREFERRED_FAMILIES),
        "allowed_accents": sorted(ALLOWED_ACCENTS),
        "interval_minutes": int(settings().get("wallpaper", {}).get("interval_minutes", 15)),
        "monitor_mode": settings().get("wallpaper", {}).get("monitor_mode", "shared"),
        "history_depth": settings().get("wallpaper", {}).get("history_depth", 20),
        "requirement_met": len(valid) >= minimum_count,
    }
    if as_json:
        print(json.dumps(result, indent=2))
    else:
        print(f"Fenrir wallpapers: {len(valid):,} valid / {total:,} image files; {invalid:,} rejected ({palette_excluded:,} excluded by color palette)")
        print(f"Target: at least {minimum_count:,}; minimum 2560x1440 landscape; preferred 3840x2160+")
        print("Palette: exclude yellow/orange/brown; prefer red/purple/blue/white/black; green allowed")
        print(f"Directory: {result['directory']}")
        dynamic = bool(settings().get("theme", {}).get("dynamic_colors", True))
        print(f"Rotation: every {result['interval_minutes']} minutes; monitor mode: {result['monitor_mode']}; no-repeat depth: {result['history_depth']}")
        print(f"Dynamic accent extraction {'enabled' if dynamic else 'disabled'}")
        print("5000-image collection target: " + ("MET" if result["requirement_met"] else "NOT MET"))
        print("Rotation uses all currently qualifying images; the 5000-image target is not a prerequisite.")
    return 0


def launch_wallpaper_studio() -> None:
    """Launch the private Catalog Studio using Fenrir's configured paths."""
    catalog_cli = shutil.which("fenrir-catalog")
    if catalog_cli is None:
        fallback = Path.home() / ".local/bin/fenrir-catalog"
        catalog_cli = str(fallback) if fallback.is_file() else None
    if (
        not catalog_cli
        or not Path(catalog_cli).is_file()
        or not os.access(catalog_cli, os.X_OK)
    ):
        raise RuntimeError(
            "fenrir-catalog is unavailable; install the Fenrir Wallpaper Catalog companion first"
        )

    catalog_home = Path.home() / ".local/share/fenrir/catalog"
    database = catalog_home / "catalog.sqlite3"
    quarantine = catalog_home / "quarantine"
    cache_home = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache"))
    cache_root = cache_home / "fenrir" / "catalog" / "thumbnails"
    if not database.is_file():
        raise RuntimeError(f"Catalog database does not exist: {database}")
    if not quarantine.is_dir() or quarantine.is_symlink():
        raise RuntimeError(f"Catalog quarantine directory is unavailable or unsafe: {quarantine}")
    if cache_root.is_symlink():
        raise RuntimeError(f"Wallpaper Studio cache must not be a symbolic link: {cache_root}")
    cache_root.mkdir(parents=True, exist_ok=True, mode=0o700)

    command = [
        catalog_cli,
        "catalog", "library", "picker",
        "--database", str(database),
        "--quarantine-root", str(quarantine),
        "--cache-root", str(cache_root),
        "--reviewer", os.environ.get("USER", ""),
    ]
    try:
        subprocess.Popen(
            command,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
            close_fds=True,
        )
    except OSError as exc:
        raise RuntimeError(f"Wallpaper Studio could not be launched: {exc}") from exc


def sync_catalog_collection(
    collection_id: str,
    *,
    target_count: int = 5000,
    database: Path | None = None,
    quarantine_root: Path | None = None,
) -> dict:
    """Stage one explicitly curated Catalog collection into the rotation directory."""
    if (
        not isinstance(collection_id, str)
        or not collection_id.strip()
        or len(collection_id.strip()) > 128
        or any(ord(character) < 32 for character in collection_id)
    ):
        raise RuntimeError("A valid --collection-id is required for Catalog synchronization")
    if target_count not in {5000, 10000, 20000}:
        raise RuntimeError("Catalog target count must be 5000, 10000 or 20000")

    catalog_cli = shutil.which("fenrir-catalog")
    if not catalog_cli:
        fallback = Path.home() / ".local/bin/fenrir-catalog"
        catalog_cli = str(fallback) if fallback.is_file() else None
    if not catalog_cli or not Path(catalog_cli).is_file() or not os.access(catalog_cli, os.X_OK):
        raise RuntimeError("fenrir-catalog is unavailable; install the Fenrir Wallpaper Catalog companion first")

    catalog_home = Path.home() / ".local/share/fenrir/catalog"
    database_path = (database or catalog_home / "catalog.sqlite3").expanduser()
    quarantine_path = (quarantine_root or catalog_home / "quarantine").expanduser()
    destination = wallpaper_dir().expanduser()
    if not database_path.is_file():
        raise RuntimeError(f"Catalog database does not exist: {database_path}")
    if not quarantine_path.is_dir():
        raise RuntimeError(f"Catalog quarantine directory does not exist: {quarantine_path}")

    command = [
        catalog_cli,
        "catalog", "library", "sync",
        "--database", str(database_path),
        "--quarantine-root", str(quarantine_path),
        "--destination", str(destination),
        "--target-count", str(target_count),
        "--collection-id", collection_id.strip(),
    ]
    try:
        completed = subprocess.run(
            command,
            capture_output=True,
            text=True,
            check=False,
            timeout=1800,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise RuntimeError(f"Catalog collection synchronization could not complete: {exc}") from exc
    if completed.returncode != 0:
        detail = (completed.stderr or completed.stdout or "Catalog command failed").strip()
        raise RuntimeError(f"Catalog collection synchronization failed: {detail[-2000:]}")
    try:
        catalog_result = json.loads(completed.stdout)
    except (TypeError, ValueError) as exc:
        raise RuntimeError("Catalog returned an invalid synchronization report") from exc
    if not isinstance(catalog_result, dict):
        raise RuntimeError("Catalog returned an invalid synchronization report")

    index_refresh = {"refreshed": False, "valid_count": None, "rejected_count": None}
    try:
        valid, rejected, total, palette_excluded, _scores = validated_wallpapers()
        index_refresh = {
            "refreshed": True,
            "valid_count": len(valid),
            "rejected_count": rejected,
            "file_count": total,
            "palette_excluded_count": palette_excluded,
        }
    except Exception as exc:
        index_refresh["error"] = str(exc)[:500]

    return {
        "collection_id": collection_id.strip(),
        "destination": str(destination),
        "catalog_sync": catalog_result,
        "wallpaper_index": index_refresh,
        "rotation_uses_new_images_on_next_cycle": True,
        "image_files_modified_after_sync": False,
        "rights_or_acceptance_changed": False,
    }


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("action", choices=["next", "watch", "status", "sync-catalog", "studio"], nargs="?", default="next")
    parser.add_argument("--interval", type=int, default=0, help="Rotation interval in minutes (default: 15 or config)")
    parser.add_argument("--json", action="store_true", help="Emit machine-readable status")
    parser.add_argument("--collection-id", help="Existing curated Fenrir Catalog collection to stage into the wallpaper rotation directory.")
    parser.add_argument("--target-count", type=int, choices=(5000, 10000, 20000), default=5000)
    parser.add_argument("--database", type=Path, help="Optional explicit Catalog database path.")
    parser.add_argument("--quarantine-root", type=Path, help="Optional explicit Catalog quarantine path.")
    args = parser.parse_args()
    try:
        if args.action == "studio":
            launch_wallpaper_studio()
            return 0
        if args.action == "sync-catalog":
            result = sync_catalog_collection(
                args.collection_id,
                target_count=args.target_count,
                database=args.database,
                quarantine_root=args.quarantine_root,
            )
            if args.json:
                print(json.dumps(result, ensure_ascii=False, indent=2))
            else:
                sync = result["catalog_sync"]
                index = result["wallpaper_index"]
                print(f"Fenrir Catalog collection {result['collection_id']} synchronized.")
                print(f"New: {sync.get('installed', 0)}; already present: {sync.get('already_present', 0)}; skipped: {sum(sync.get('skipped', {}).values())}.")
                print(f"Rotation directory: {result['destination']}")
                if index.get("refreshed"):
                    print(f"Qualifying wallpapers now indexed: {index['valid_count']:,}. New images enter the next rotation cycle.")
                else:
                    print(f"Wallpaper index refresh could not complete: {index.get('error', 'unknown error')}")
            return 0
        if args.action == "next":
            apply(next_wallpapers())
            return 0
        if args.action == "status":
            return report_status(args.json)
        interval = args.interval or int(settings().get("wallpaper", {}).get("interval_minutes", 15))
        if not 1 <= interval <= 1440:
            raise RuntimeError("Rotation interval must be between 1 and 1440 minutes")
        while True:
            try:
                apply(next_wallpapers())
                time.sleep(interval * 60)
            except Exception as exc:
                print(f"fenrir-wallpaper: {exc}", file=sys.stderr)
                time.sleep(min(interval * 60, 60))
    except KeyboardInterrupt:
        return 0
    except Exception as exc:
        print(f"fenrir-wallpaper: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
