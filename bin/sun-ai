#!/usr/bin/env bash
set -Eeuo pipefail

UI_URL="http://127.0.0.1:8765"
OLLAMA_UNIT="ollama.service"
STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}/sun-ai"
STARTED_MARKER="$STATE_HOME/ollama-started-by-sun-ai"

usage() {
  cat <<'USAGE'
Sun AI local runtime control

Usage: sun-ai {open|start|stop|status|logs}
  open    Start Ollama only when needed, start Sun AI, and open the dashboard
  start   Start Ollama and the local dashboard service
  stop    Stop the dashboard and Ollama (frees GPU/RAM for gaming/recording)
  status  Show model-runtime and local dashboard status
  logs    Show the Sun AI user-service journal
USAGE
}

wait_for_url() {
  local url="$1" tries="${2:-45}"
  for _ in $(seq 1 "$tries"); do
    curl --silent --fail "$url" >/dev/null 2>&1 && return 0
    sleep 1
  done
  return 1
}

start_runtime() {
  command -v pkexec >/dev/null 2>&1 || { echo "pkexec is missing; install polkit and start the Hyprland authentication agent." >&2; exit 1; }
  if ! systemctl is-active --quiet "$OLLAMA_UNIT"; then
    echo "Starting local Ollama service through the graphical authorization prompt..."
    pkexec /usr/bin/systemctl start "$OLLAMA_UNIT"
    mkdir -p "$STATE_HOME"
    : > "$STARTED_MARKER"
    chmod 0600 "$STARTED_MARKER"
  fi
  systemctl --user start sun-ai.service
  if ! wait_for_url "$UI_URL/api/health" 30; then
    systemctl --user --no-pager --full status sun-ai.service || true
    echo "Sun AI did not start. Inspect: sun-ai logs" >&2
    exit 1
  fi
}

case "${1:-open}" in
  open)
    start_runtime
    if command -v xdg-open >/dev/null 2>&1; then
      xdg-open "$UI_URL" >/dev/null 2>&1 &
    else
      printf 'Open %s in a browser.\n' "$UI_URL"
    fi
    ;;
  start)
    start_runtime
    echo "Sun AI is ready at $UI_URL"
    ;;
  stop)
    systemctl --user stop sun-ai.service 2>/dev/null || true
    if [[ -e "$STARTED_MARKER" ]]; then
      if systemctl is-active --quiet "$OLLAMA_UNIT"; then
        pkexec /usr/bin/systemctl stop "$OLLAMA_UNIT"
      fi
      rm -f -- "$STARTED_MARKER"
      echo "Sun AI and its Ollama runtime stopped. GPU and RAM are released."
    else
      echo "Sun AI stopped. Ollama was already running before Sun AI started it, so it was left untouched."
    fi
    ;;
  status)
    printf 'Sun AI UI: '
    systemctl --user is-active sun-ai.service 2>/dev/null || true
    printf 'Ollama: '
    systemctl is-active "$OLLAMA_UNIT" 2>/dev/null || true
    [[ -e "$STARTED_MARKER" ]] && echo 'Ollama was started by Sun AI.' || true
    if command -v ollama >/dev/null 2>&1 && systemctl is-active --quiet "$OLLAMA_UNIT"; then
      ollama list || true
    fi
    printf 'Dashboard: %s\n' "$UI_URL"
    ;;
  logs)
    journalctl --user -u sun-ai.service -n 100 --no-pager
    ;;
  -h|--help|help) usage ;;
  *) usage >&2; exit 2 ;;
esac
