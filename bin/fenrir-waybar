#!/usr/bin/env python3
"""Start or stop Waybar according to Fenrir's persisted preference."""
from __future__ import annotations
import argparse, os, subprocess, sys, tomllib
from pathlib import Path

def enabled() -> bool:
    path = Path(os.environ.get("XDG_CONFIG_HOME", Path.home()/".config")) / "fenrir" / "settings.toml"
    try:
        return bool(tomllib.loads(path.read_text(encoding="utf-8")).get("waybar", {}).get("enabled", True))
    except (OSError, tomllib.TOMLDecodeError):
        return True

def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("action", choices=("start", "stop", "restart"), nargs="?", default="start")
    args = parser.parse_args()
    if args.action in {"stop", "restart"} or (args.action == "start" and not enabled()):
        subprocess.run(["pkill", "-x", "waybar"], check=False)
    if args.action == "stop" or (args.action == "start" and not enabled()):
        return 0
    try:
        subprocess.Popen(["waybar"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError as exc:
        print(f"fenrir-waybar: {exc}", file=sys.stderr)
        return 1
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
