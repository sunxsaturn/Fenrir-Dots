{
  "layer": "top",
  "position": "top",
  "height": 38,
  "spacing": 8,
  "modules-left": ["hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": ["network", "pulseaudio", "cpu", "memory", "tray"],
  "hyprland/workspaces": { "disable-scroll": true, "all-outputs": true, "format": "{name}" },
  "hyprland/window": { "max-length": 48, "separate-outputs": true },
  "clock": { "format": "{:%a %d %b  %H:%M}", "tooltip-format": "{:%A, %d %B %Y}" },
  "network": { "format-wifi": "󰤨 {essid}", "format-ethernet": "󰈀 {ipaddr}", "format-disconnected": "󰤭 Offline", "tooltip": true },
  "pulseaudio": { "format": "{icon} {volume}%", "format-muted": "󰝟 Muted", "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] }, "on-click": "pavucontrol" },
  "cpu": { "format": "󰍛 {usage}%", "interval": 3 },
  "memory": { "format": "󰘚 {percentage}%", "interval": 5 },
  "tray": { "spacing": 8 }
}
